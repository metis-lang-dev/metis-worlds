% nav_domain — going places (alf-hierarchy step 1, the architect, 2026-10-22): the household's
% navigation as a specialist. Goal in: goto(R); result out: reached(R). It sees one dynamic
% fact (where the agent is) and one static one (where each receptacle is). A generated instance
% (world/gen_hier.py) includes this file and adds the game's types, its recat facts, the current
% position and the goal.
catalog nav_domain 1.
provenance text "ALFWorld navigation as a lifted specialist: go to a receptacle; the task domain asks, the result answers" "2026-10-22".
layers (dyn).
stages (act).

namespace nav produce (dyn).

bwd recat(receptacle, location).          % static: the receptacle's location

pred at(location) : nav.                  % the world: exactly one
pred goto(receptacle) : nav.              % the goal (in)
pred reached(receptacle) : nav.           % the result (out)

stage act {
  %% I go to {R}.
  go [dyn] : goto(R) * at(L) * $recat(R, L2) * L <> L2 -o at(L2) * reached(R).
  %% {R} is right here.
  here [dyn] : goto(R) * $at(L) * $recat(R, L) -o reached(R).
}
