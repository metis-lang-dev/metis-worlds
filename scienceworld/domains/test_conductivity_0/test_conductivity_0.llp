namespace sw produce (dyn).
% the perception (the text; never the simulator's hidden properties)
pred here(thing) : sw.
pred door(thing, doorstate) : sw.
pred in(thing, thing) : sw.
pred state(thing, onoff) : sw.
pred closed(thing) : sw.
pred open(thing) : sw.
pred reads(thing, temp) : sw.
pred holds(thing) : sw.
pred matter(thing, phase) : sw.
pred measured(thing, temp) : sw.
pred focused(thing) : sw.
pred connected(thing, thing) : sw.
pred task(kind, thing, thing, thing) : sw.
pred threshold(temp) : sw.
pred said(said_kind) : sw.
% the commands, one per intent
pred cmd_go(thing) : sw.
pred cmd_open(thing) : sw.
pred cmd_close(thing) : sw.
pred cmd_take(thing) : sw.
pred cmd_drop(thing) : sw.
pred cmd_focus(thing) : sw.
pred cmd_connect(thing, thing) : sw.
pred cmd_move(thing, thing) : sw.
pred cmd_activate(thing) : sw.
pred cmd_deactivate(thing) : sw.
pred cmd_use(thing, thing) : sw.
pred cmd_examine(thing) : sw.
pred cmd_wait : sw.
pred cmd_look : sw.
pred cmd_unknown : sw.
% the outcomes
type act {go open close take drop focus connect move activate deactivate use examine wait look unknown}.
pred done(act) : sw.
pred refused(act) : sw.
pred progress(act) : sw.
stage act {
  %% I can't do that here.
  unknown [dyn] : cmd_unknown -o refused(unknown).
}

