% grasp_domain — taking a thing and attending to it (world-scienceworld step 2): goal in get(O);
% result out got(O) (in hand and focused: ScienceWorld's tasks score the focus), or elsewhere(R)
% when the thing is in another room (the task's text says where). It sees where the agent is,
% what is in the room, what it holds.
catalog grasp_domain 1.
provenance text "ScienceWorld grasp as a lifted specialist: pick up and focus; the task asks, the result answers" "2026-10-23".
layers (dyn).
stages (act).

namespace grasp produce (dyn).

bwd where(thing, room).                   % static: the room the task's text names for the thing

pred here(room) : grasp.
pred in(thing, thing) : grasp.            % the world: what is in what
pred holds(thing) : grasp.
pred focused(thing) : grasp.
pred get(thing) : grasp.                  % the goal (in)
pred got(thing) : grasp.                  % the result (out)
pred elsewhere(room) : grasp.             % the refusal: it is in R
pred taking(thing) : grasp.               % the token between the two steps

stage act {
  %% I pick up {O}.
  take [dyn] : get(O) * $here(R) * $where(O, R) -o holds(O) * taking(O).
  %% I focus on {O}.
  focus [dyn] : taking(O) * $holds(O) -o focused(O) * got(O).
  %% {O} is in {R}, not here.
  not_here [dyn] : get(O) * $here(L) * $where(O, R) * L <> R -o elsewhere(R).
}
