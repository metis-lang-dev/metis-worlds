% nav_domain — going places in the house (world-scienceworld step 2, the architect, 2026-10-23):
% rooms behind doors, walked. Goal in: goto(G); result out: reached(G). It sees where the agent is
% and the doors of that room (open or closed), and knows the house's routes as an instance fact:
% next(L, G, R) = from L, to reach G, step into R. An instance (world/gen_hier.py) includes this
% file and adds the rooms, the routes, the current room and the goal.
catalog nav_domain 1.
provenance text "ScienceWorld navigation as a lifted specialist: rooms by doors, a route table; the task asks, the result answers" "2026-10-23".
layers (dyn).
stages (act).

namespace nav produce (dyn).

bwd next(room, room, room).               % static: the route table (from, to, the next room)
bwd same(room, room).                     % static: same(R, R) for every room

pred here(room) : nav.                    % the world: exactly one
pred door(room, doorstate) : nav.         % the world: this room's doors
pred goto(room) : nav.                    % the goal (in)
pred reached(room) : nav.                 % the result (out)

stage act {
  %% {G} is right here.
  here_already [dyn] : goto(G) * $here(G) -o reached(G).
  %% The door to {D} is closed: I open it.
  open [dyn] : goto(G) * $here(L) * $next(L, G, D) * door(D, closed) -o goto(G) * door(D, open).
  %% I step into {R} on the way to {G}.
  go [dyn] : goto(G) * here(L) * $next(L, G, R) * $door(R, open) * R <> G -o here(R) * goto(G).
  %% I step into {R}: there.
  go_last [dyn] : goto(G) * here(L) * $next(L, G, R) * $door(R, open) * $same(R, G) -o here(R) * reached(G).
}
