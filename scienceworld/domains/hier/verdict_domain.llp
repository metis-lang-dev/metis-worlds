% verdict_domain — the answer given to the world (world-scienceworld step 2): goal in put(O, C);
% result out placed(O). Moving O into the box is the task's verdict; the game disconnects it.
catalog verdict_domain 1.
provenance text "ScienceWorld's verdict as a lifted specialist: move the thing into the box the task names" "2026-10-23".
layers (dyn).
stages (act).

namespace verdict produce (dyn).

pred put(thing, thing) : verdict.         % the goal (in)
pred placed(thing) : verdict.             % the result (out)

stage act {
  %% I move {O} to {C}.
  move [dyn] : put(O, C) -o placed(O).
}
