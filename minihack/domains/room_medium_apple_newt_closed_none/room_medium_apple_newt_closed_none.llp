% room_medium_apple_newt_closed_none — a MiniHack level as a package (generated by world/gen_level.py): its cells and names
% as types, the perceived start as #init; declarations only — the rules are what the agent's runs extract.
catalog room_medium_apple_newt_closed_none 1.
provenance text "generated MiniHack level room_medium_apple_newt_closed_none seed 1" "2026-10-21".
layers (dyn).
stages (act).
type cell {c0_0 c1_0 c2_0 c3_0 c4_0 c5_0 c6_0 c0_1 c1_1 c2_1 c3_1 c4_1 c5_1 c6_1 c0_2 c1_2 c2_2 c3_2 c4_2 c5_2 c6_2 c0_3 c1_3 c2_3 c3_3 c4_3 c5_3 c6_3 c0_4 c1_4 c2_4 c3_4 c4_4 c5_4 c6_4}.
type thing {apple club flint_stones key leather_armor rocks sling}.
type beast {jackal newt rat}.
type dir {n e s w ne se sw nw}.
type doorstate {open closed}.
type hungerstate {satiated normal hungry weak fainting fainted starved}.
type said_kind {ate blocked cant died door_closed door_here door_locked door_opened fell_pit hit hunger hurt killed nevermind nothing_here other picked prompt see_here stopped trap_door welcome}.
type num {n0 .. n40}.
namespace mh produce (dyn).
% the perception
pred agent_at(cell) : mh.
pred floor(cell) : mh.
pred wall(cell) : mh.
pred corridor(cell) : mh.
pred door(cell, doorstate) : mh.
pred stairs_down(cell) : mh.
pred stairs_up(cell) : mh.
pred obj(thing, cell) : mh.
pred monster(beast, cell) : mh.
pred trap(said_kind, cell) : mh.
pred unknown(cell) : mh.
pred hp(num) : mh.
pred hpmax(num) : mh.
pred hunger(hungerstate) : mh.
pred turn(num) : mh.
pred holds(thing) : mh.
pred said(said_kind) : mh.
% the commands, one per intent
pred cmd_move(dir) : mh.
pred cmd_pickup : mh.
pred cmd_eat : mh.
pred cmd_down : mh.
pred cmd_wait : mh.
pred cmd_open(dir) : mh.
pred cmd_kick(dir) : mh.
pred cmd_search : mh.
pred cmd_apply : mh.
pred cmd_unknown : mh.
% the outcomes (the extracted rules will produce them)
type act {move pickup eat down wait open kick search apply unknown}.
pred done(act) : mh.
pred refused(act) : mh.
pred progress(act) : mh.
stage act {
  %% I can't do that here.
  unknown [dyn] : cmd_unknown -o refused(unknown).
}

