% director_tree_domain — the director as a TREE (specialist-tree s-404d001f step 2, rulings v3 and v4; metis-lang
% spec/15 §4 form S). Today's director (director_domain.llp, metis-catalog's: its rules below unchanged, so its
% effects — wake, sleep, forward, ask, ended — are the same), over the PROTOCOL module (protocol_domain.llp:
% the reports and the grants; the specialists include it too, neither side names the other), and the tree:
%   the RESOURCE: free(R) or holder(D, R); a woken specialist is GRANTED R (the request is the activation: the
%     sequential case), the holder before it REVOKED; a holder that sleeps frees it. The agent syncs tick__grant(D, R)
%     into D's session (the protocol's pred): only the holder's commands reach the world.
%   HYSTERESIS (§9 rule 4): a grant is not revoked within k ticks of being given: held(D, A) ages one step per
%     tick token the agent puts in at the boundary; a revoke or a hand-over waits (late, want) until the age is
%     mature_grant. A status must hold m ticks before a tree rule acts on it: age_of(D, A), reset by changed(D)
%     (the agent puts it in with the new status), aged by tick_s(D); a rule acting on a status reads
%     `$tick__status(D, S) * $age_of(D, A) * $mature_status(A)`. The instance chooses k and m (mature_grant,
%     young_grant, mature_status); in step 2 activation stays the director's, so no rule acts on a status yet.
%   the PATH: path(D) and tick__goal(D) while D is woken, not asleep.
% director_domain — activation from context as a domain of its own (metis-agent docs/DIRECTOR.md;
% alf-hierarchy step 3, the architect, 2026-10-22), LIFTED: the instance says which specialists
% exist, which KINDS of atom each handles (handles/2, generated from the specialists' declared
% ports), which kinds are results, which end the episode, which refusals detour (a specialist that
% is elsewhere → the navigator) and how a second refusal escalates. The director never acts in the
% world: it sees kinds (seen(K): an atom of kind K arrived — its arguments ride in the
% orchestrator's frame, not here) and a specialist's idleness (idle(D)); its effects are the
% agent's own verbs — wake(D), sleep(D), forward(D, K), ask(K), ended(K).
%
% One beat = one arrival. The orchestrator (or the driver, experiments/hier.py --director) puts
% +seen(K) in, runs to quiescence, reads the effects out, and acts on them: forward(D, K) sends D
% the atom of kind K whose frame it holds — the one just seen, or, after a detour, the one it
% remembered for D.
catalog director_tree_domain 1.
provenance text "the director as a tree: today's routing rules, the resource's grants with hysteresis, the path, the statuses" "2026-10-25".
include "protocol_domain.llp".
layers (dyn).
stages (act).
types (domain kind).   % completed by the instance that includes this file (spec 12)

namespace dir produce (dyn).

% ── the instance's facts ──
bwd specialist(domain).                   % a domain the director may wake and put to sleep
bwd planner(domain).                      % the domain that is active throughout and takes the results
bwd handles(domain, kind).                % D consumes atoms of kind K
bwd result(kind).                         % a kind that is a specialist's answer
bwd end(kind).                            % a kind that ends the episode (done, stuck, …)
bwd finished(kind).                       % … of which the ones that are success: ended, no ask (the instance: done)
bwd detour(kind, kind).                   % a refusal of kind K1 is answered by a goal of kind K2 to another specialist, once
bwd escalate(kind, kind).                 % … and a second time becomes K3 for the planner
bwd rename(kind, kind, kind).             % the orchestrator's frames: an atom of K1 forwarded as K2 is sent under the name K3 (elsewhere(R) → goto(R)); the rules never read it
bwd nohandler(kind).                      % the complement: a kind nobody handles

% ── the state ──
pred active(domain) : dir.
pred inactive(domain) : dir.
pred attention(domain) : dir.             % exactly one: the domain the last atom went to
pred sent(domain, kind) : dir.            % the goal D is working on (its frame is the orchestrator's)
pred pending(domain, kind) : dir.         % a goal put aside for the detour
pred fresh : dir.                         % no detour open
pred rerouted : dir.                      % a detour is open: a second refusal escalates

% ── the input port ──
pred seen(kind) : dir.
pred idle(domain) : dir.

% ── the output port ──
pred wake(domain) : dir.
pred sleep(domain) : dir.
pred forward(domain, kind) : dir.
pred ask(kind) : dir.                     % the episode ended in a kind that needs the person
pred ended(kind) : dir.

% ── the tree (the tick) ──
type age {a0 a1 a2 a3}.
bwd older(age, age).
bwd top(age).
bwd mature_grant(age).                    % the instance's k: the ages at which a grant may be revoked
bwd young_grant(age).                     % … the rest
bwd mature_status(age).                   % the instance's m: the ages at which a status is acted on
older(a0, a1).
older(a1, a2).
older(a2, a3).
top(a3).
pred free(resource) : dir.                % the resource, free
pred holder(domain, resource) : dir.      % … or held
pred held(domain, age) : dir.             % the holder's grant, its age in ticks
pred want(domain) : dir.                  % woken while the holder's grant is young: the grant waits
pred nowant(domain) : dir.
pred late(domain) : dir.                  % asleep while its grant is young: the release waits
pred nolate(domain) : dir.
pred path(domain) : dir.                  % D is on the running branch
pred offpath(domain) : dir.
pred tick : dir.                          % the boundary's token for the grants' ages (the agent's)
pred tick_s(domain) : dir.                % … for D's status's age
pred changed(domain) : dir.               % D's status changed at this boundary
pred age_of(domain, age) : dir.           % how many ticks D's status has held

stage act {
  % ── activation by what is seen ──
  %% {K} arrived: I wake {D} for it.
  wake_for [dyn] : seen(K) * $handles(D, K) * $specialist(D) * inactive(D) * attention(D0) -o active(D) * wake(D) * forward(D, K) * sent(D, K) * attention(D).
  %% {K} arrived: {D} is up, it gets it (no detour open: a result then belongs to the detour).
  route [dyn] : seen(K) * $handles(D, K) * $active(D) * $planner(D) * $fresh * attention(D0) -o forward(D, K) * attention(D).
  %% {K} arrived for {D}, which is busy: it gets it.
  route_busy [dyn] : seen(K) * $handles(D, K) * $specialist(D) * $active(D) * attention(D0) -o forward(D, K) * sent(D, K) * attention(D).

  % ── a specialist's answer frees it (the grace is the orchestrator's: idle arrives after linger beats) ──
  %% {D} is idle: it sleeps.
  sleep [dyn] : idle(D) * active(D) * $specialist(D) * sent(D, K) -o inactive(D) * sleep(D).
  %% {D} is already asleep.
  idle_gone [dyn] : idle(D) * $inactive(D) -o ().

  % ── the detour: a specialist is elsewhere, the navigator takes it there, the goal waits ──
  %% {S} cannot: {K1}. I send {D2} first ({K2}) and keep {K0} for {S}.
  detour [dyn] : seen(K1) * $detour(K1, K2) * $handles(D2, K2) * sent(S, K0) * active(S) * inactive(D2) * fresh * attention(S) -o pending(S, K0) * inactive(S) * sleep(S) * active(D2) * wake(D2) * forward(D2, K2) * sent(D2, K2) * rerouted * attention(D2).
  %% {D2} answered {K}: {S} gets {K0} back.
  resume [dyn] : seen(K) * $result(K) * $sent(D2, K2) * pending(S, K0) * inactive(S) * rerouted * attention(D2) -o active(S) * wake(S) * forward(S, K0) * sent(S, K0) * fresh * attention(S).
  %% {S} cannot again ({K1}): the planner hears {K3}.
  escalate [dyn] : seen(K1) * $detour(K1, K2) * $escalate(K1, K3) * $planner(P) * sent(S, K0) * active(S) * rerouted * attention(S) -o forward(P, K3) * fresh * attention(P).

  % ── the ends ──
  %% {K}: the task is done.
  finished [dyn] : seen(K) * $finished(K) -o ended(K).
  %% {K}: the episode is over without the task done. I ask.
  cornered [dyn] : seen(K) * $end(K) -o ended(K) * ask(K).
  %% Nobody handles {K}: I ask.
  unknown [dyn] : seen(K) * $nohandler(K) -o ask(K).

  % ── the tree: the resource (with its hysteresis), the path, the statuses' ages ──
  %% {D} is woken: it holds {R}.
  grant_free [dyn] : $wake(D) * free(R) -o holder(D, R) * held(D, a0) * tick__grant(D, R).
  %% {D} is woken: it takes {R} from {X}.
  grant_from [dyn] : $wake(D) * holder(X, R) * held(X, A) * $mature_grant(A) * D <> X -o holder(D, R) * held(D, a0) * tick__revoke(X, R) * tick__grant(D, R).
  %% {D} is woken; {X}'s grant is young: {D} waits for it.
  grant_wait [dyn] : $wake(D) * nowant(D) * $holder(X, R) * $held(X, A) * $young_grant(A) * D <> X -o want(D).
  %% {X}'s grant is old enough: {D} takes {R}.
  grant_late [dyn] : want(D) * holder(X, R) * held(X, A) * $mature_grant(A) * D <> X -o holder(D, R) * held(D, a0) * nowant(D) * tick__revoke(X, R) * tick__grant(D, R).
  %% {R} is free: {D} takes it.
  grant_late_free [dyn] : want(D) * free(R) -o holder(D, R) * held(D, a0) * nowant(D) * tick__grant(D, R).
  %% {D} sleeps: {R} is free.
  release [dyn] : $sleep(D) * holder(D, R) * held(D, A) * $mature_grant(A) -o free(R) * tick__revoke(D, R).
  %% {D} sleeps; its grant is young: the release waits.
  release_wait [dyn] : $sleep(D) * nolate(D) * $holder(D, R) * $held(D, A) * $young_grant(A) -o late(D).
  %% {D}'s grant is old enough: {R} is free.
  release_late [dyn] : late(D) * holder(D, R) * held(D, A) * $mature_grant(A) -o free(R) * nolate(D) * tick__revoke(D, R).
  %% A tick: {D}'s grant is older.
  age_grant [dyn] : tick * held(D, A) * $older(A, B) -o held(D, B).
  %% A tick: {D}'s grant is as old as it counts.
  age_grant_top [dyn] : tick * $held(D, A) * $top(A) -o ().
  %% A tick: {R} is free.
  tick_free [dyn] : tick * $free(R) -o ().
  %% {D}'s status changed: its age starts again.
  status_reset [dyn] : changed(D) * age_of(D, A) -o age_of(D, a0).
  %% A tick: {D}'s status is older.
  status_age [dyn] : tick_s(D) * age_of(D, A) * $older(A, B) -o age_of(D, B).
  %% A tick: {D}'s status is as old as it counts.
  status_top [dyn] : tick_s(D) * $age_of(D, A) * $top(A) -o ().
  %% {D} is on the path.
  path_on [dyn] : $wake(D) * offpath(D) -o path(D) * tick__goal(D).
  %% {D} is off the path.
  path_off [dyn] : $sleep(D) * path(D) * tick__goal(D) -o offpath(D).
}
