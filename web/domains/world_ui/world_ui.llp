% world_ui — the world page's widgets over the lifted voice-navigation base (alf-demo step 3b,
% alfworld/docs/DEMO.md §4: "voice nav: ui_domain.llp + world_ui.llp"). Facts only, as the
% loop console's ui.llp and the synth's: the base is ui_domain.llp beside this file, a copy of
% metis-loop's domains/ui/ui_domain.llp v6.5 (COPIES.md says which commit; the suite checks
% it against the source when the source is there). The page is web/world.html (the same ids
% as data-w).
%
% The map is a LIST: the things on it (places, things, the agent) are its entries, picked by
% name ("pick the microwave") or by number once NUMBERS shows them, as any list's. They are
% not widgets: the base is finite by design (widgets and roles are types; what a pick names is
% the page's), so a JUMP labels the map, and a pick inside it names the thing.
catalog world_ui 1.
provenance text "the world page (map, task card, the dialog band, the hierarchy, the journal) over ui_domain.llp, the lifted voice-navigation base" "2026-10-22".
include "ui_domain.llp".

type widget {root band ctrl play step map card cardclose talk hierarchy hlist journal jlog}.

% the tree: child(parent, child)
child(root, band).
child(band, ctrl).
child(ctrl, play).
child(ctrl, step).
child(root, map).
child(root, card).
child(card, cardclose).
child(root, talk).
child(root, hierarchy).
child(hierarchy, hlist).
child(root, journal).
child(journal, jlog).

% the roles, one each
role(root, container).
role(band, container).
role(ctrl, composite).
role(play, item).
role(step, item).
role(map, list).
role(card, dialog).
role(cardclose, button).
role(talk, dock).
role(hierarchy, dock).
role(hlist, list).
role(journal, dock).
role(jlog, container).

% where the focus lands when a composite or the dialog is entered
entry(ctrl, play).
entry(card, cardclose).

% the page at the start: the root focused, nothing to go back to, no dialog, commands, nothing
% pending; every dock shown, the task card closed (its button is not rendered while it is), every
% widget present
#init focused(root) 1
#init prev(root) 1
#init free 1
#init mode(command) 1
#init ready 1
#init numbers_hidden 1
#init no_choice 1
#init idle_jump 1
#init shown(root) 1
#init shown(band) 1
#init shown(ctrl) 1
#init shown(play) 1
#init shown(step) 1
#init shown(map) 1
#init shown(talk) 1
#init shown(hierarchy) 1
#init shown(hlist) 1
#init shown(journal) 1
#init shown(jlog) 1
#init hidden(card) 1
#init hidden(cardclose) 1
#init present(root) 1
#init present(band) 1
#init present(ctrl) 1
#init present(play) 1
#init present(step) 1
#init present(map) 1
#init present(card) 1
#init present(cardclose) 1
#init present(talk) 1
#init present(hierarchy) 1
#init present(hlist) 1
#init present(journal) 1
#init present(jlog) 1
