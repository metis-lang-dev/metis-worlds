% Comfort: what the person would want to know about a room's air, from the Bluetooth thermometers
% (not yet wired: untracked). Advice only: this package switches nothing; it reads the units' power
% (shared) and says what would help. The rules read the semantic world's levels (domain.yaml's
% beliefs:/levels:): chill, heat, damp per room, power per unit. The host still keeps, per room,
% cold_room | comfy_room | warm_room | untracked and humid_room | fresh_room | humidity_unknown, with
% hysteresis ('Steady reading'); of those the rules read only untracked (a room the world cannot know
% holds no level atom, so the refusal needs a member of its own), and the edges got_cold(R),
% got_warm(R), got_humid(R) it asserts for one beat.
catalog comfort 1.
provenance text "comfort: a room turning cold, warm or humid, and what would help, from the thermometers and the ventilation units' state" "2026-11-21".
layers (dyn).
stages (serve).
include "../shared/home_world.llp".

pred cold_room(room) : home.
pred comfy_room(room) : home.
pred warm_room(room) : home.
pred untracked(room) : home.          % no thermometer, or its reading too old to know (no level atom)
pred humid_room(room) : home.
pred fresh_room(room) : home.
pred humidity_unknown(room) : home.
pred got_cold(room) : home.
pred got_warm(room) : home.
pred got_humid(room) : home.

type act {comfort}.
pred cmd_comfort(room) : home.         % a person's question: how is the air in R?
pred said(act) : home.
pred refused(act) : home.

pred advise_air(room) : home.
pred advise_heater(room) : home.
pred advise_open(room) : home.
pred noted(room) : home.

% the semantic world's beliefs (metis-lang spec/16 §3) and their levels (§4): the host asserts exactly
% one level atom per room the world knows each beat, none for a room without a thermometer or whose
% reading has grown too old to know (then untracked(R) holds). A borderline reading, or one grown old
% (its spread widens while it is unheard), is a maybe_* level: the rules hedge it and advise nothing on it.
pred cold_b(room) : home.
pred warm_b(room) : home.
pred humid_b(room) : home.
type chill_level {not_cold maybe_cold cold}.
pred chill(chill_level, room) : home.
type heat_level {not_warm maybe_warm warm}.
pred heat(heat_level, room) : home.
type damp_level {dry maybe_humid humid}.
pred damp(damp_level, room) : home.

stage serve {
  %% {R} is comfortable.
  ask_comfy [dyn] : cmd_comfort(R) * $chill(not_cold, R) * $heat(not_warm, R) -o said(comfort).
  %% {R} is cold.
  ask_cold [dyn] : cmd_comfort(R) * $chill(cold, R) -o said(comfort).
  %% {R} may be cold: its thermometer's reading is borderline or old, so I am not sure.
  ask_maybe_cold [dyn] : cmd_comfort(R) * $chill(maybe_cold, R) -o said(comfort).
  %% {R} is warm.
  ask_warm [dyn] : cmd_comfort(R) * $heat(warm, R) -o said(comfort).
  %% {R} may be warm: its thermometer's reading is borderline or old, so I am not sure.
  ask_maybe_warm [dyn] : cmd_comfort(R) * $heat(maybe_warm, R) -o said(comfort).
  %% I can't tell: {R} has no thermometer, or its last reading is too old.
  ask_untracked [dyn] : cmd_comfort(R) * $untracked(R) -o refused(comfort).
  %% I can't tell: there is no such room in this home.
  ask_unknown [dyn] : cmd_comfort(rx) -o refused(comfort).

  % ── advice on an edge, given on a sure level only; a doubtful one is noted, never advised on ──
  %% {R} is getting warm and its ventilation is stopped: shall I start it?
  warm_start [dyn] : got_warm(R) * $heat(warm, R) * unit_in(U, R) * $power(off, U) -o advise_air(R).
  %% {R} is getting warm; its ventilation is already running.
  warm_running [dyn] : got_warm(R) * $heat(warm, R) * unit_in(U, R) * $power(on, U) -o noted(R).
  %% {R} is getting warm; its ventilation has not confirmed its last switch, so I advise nothing yet.
  warm_unconfirmed [dyn] : got_warm(R) * $heat(warm, R) * unit_in(U, R) * $power(unconfirmed, U) -o noted(R).
  %% {R} is getting warm and has no ventilation unit: opening a window would help.
  warm_no_unit [dyn] : got_warm(R) * $heat(warm, R) * no_unit(R) -o advise_open(R).
  %% {R} may be getting warm; the reading is borderline, so I advise nothing yet.
  warm_unsure [dyn] : got_warm(R) * $heat(maybe_warm, R) -o noted(R).
  %% {R} is getting cold and its ventilation runs without the heater: shall I turn the heater on?
  cold_heat [dyn] : got_cold(R) * $chill(cold, R) * unit_in(U, R) * $power(on, U) * $heater_off(U) -o advise_heater(R).
  %% {R} is getting cold; the heater is already on.
  cold_heating [dyn] : got_cold(R) * $chill(cold, R) * unit_in(U, R) * $heater_on(U) -o noted(R).
  %% {R} is getting cold; its ventilation is stopped.
  cold_stopped [dyn] : got_cold(R) * $chill(cold, R) * unit_in(U, R) * $power(off, U) * $heater_off(U) -o noted(R).
  %% {R} is getting cold; its ventilation has not confirmed its last switch, so I advise nothing yet.
  cold_unconfirmed [dyn] : got_cold(R) * $chill(cold, R) * unit_in(U, R) * $power(unconfirmed, U) * $heater_off(U) -o noted(R).
  %% {R} is getting cold and has no ventilation unit.
  cold_no_unit [dyn] : got_cold(R) * $chill(cold, R) * no_unit(R) -o noted(R).
  %% {R} may be getting cold; the reading is borderline, so I advise nothing yet.
  cold_unsure [dyn] : got_cold(R) * $chill(maybe_cold, R) -o noted(R).
  %% {R} is getting humid and its ventilation is stopped: shall I start it?
  humid_start [dyn] : got_humid(R) * $damp(humid, R) * unit_in(U, R) * $power(off, U) -o advise_air(R).
  %% {R} is getting humid; its ventilation is already running.
  humid_running [dyn] : got_humid(R) * $damp(humid, R) * unit_in(U, R) * $power(on, U) -o noted(R).
  %% {R} is getting humid; its ventilation has not confirmed its last switch, so I advise nothing yet.
  humid_unconfirmed [dyn] : got_humid(R) * $damp(humid, R) * unit_in(U, R) * $power(unconfirmed, U) -o noted(R).
  %% {R} is getting humid and has no ventilation unit: opening a window would help.
  humid_no_unit [dyn] : got_humid(R) * $damp(humid, R) * no_unit(R) -o advise_open(R).
  %% {R} may be getting humid; the reading is borderline, so I advise nothing yet.
  humid_unsure [dyn] : got_humid(R) * $damp(maybe_humid, R) -o noted(R).
}

#init stopped(u1) 1
#init stopped(u2) 1
#init power(off, u1) 1
#init power(off, u2) 1
#init heater_off(u1) 1
#init heater_off(u2) 1
#steps 4
