% generated by world/gen_map.py from world/home.map.json and the package's intent.yaml map: do not edit
% A device named without its room where the home has more than one: refused, the reason naming
% the rooms that have one, so the conversation asks which room. The rules never pick one.
catalog lights_which 1.
stage serve {
  %% I can't tell which light you mean: there is one in the living room, the bedroom and the lab. Which room?
  which_light_on [dyn] : cmd_light_on(la) -o refused(on).
  %% I can't tell which light you mean: there is one in the living room, the bedroom and the lab. Which room?
  which_light_off [dyn] : cmd_light_off(la) -o refused(off).
}
