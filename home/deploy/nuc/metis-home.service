[Unit]
Description=The home's rule engine (Metis, metis-worlds home) on the C++ runtime: REASONING and the tools for FSTTM, the runtime for Claude Code
After=network-online.target

[Service]
Environment=METIS_HOME_HA=http://127.0.0.1:8123
Environment=METISC=%h/metis/metis-lang/src/metisc
ExecStart=%h/.local/bin/metis-home -world %h/metis/metis-worlds/home
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
